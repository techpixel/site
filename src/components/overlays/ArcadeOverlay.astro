---
import OverlayRender from './OverlayRender.astro';

/** Hover overlay for Arcade (Figma node 2412:1051): its artwork as one image. */
---

<div class="relative h-[888px] w-[488px] text-cream">
	<div class="art absolute inset-0">
		<OverlayRender name="arcade" alt="The Arcade landing page" />
	</div>
	<div class="caption text-base">
		<p>
			arcade was Hack Club’s first general YSWS program, ran in partnership with GitHub. reached
			10000+ teens globally and awarded $400,000 in grants and prizes.
		</p>
	</div>
</div>
