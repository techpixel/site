---
import OverlayRender from './OverlayRender.astro';

/** Hover overlay for Manifesto (Figma node 2412:1063): its artwork as one image. */
---

<div class="relative h-[888px] w-[488px] text-cream">
	<div class="art absolute inset-0">
		<OverlayRender name="manifesto" alt="Photo collage from the Manifesto site" />
	</div>
	<div class="caption text-base">
		<p>
			Made in 2 days, Manifesto is a love letter to Hack Club and a serious yet friendly invitation
			to apply to the Hack Club Gap Year Program. ~1,000 people applied.
		</p>
	</div>
</div>
