---
import OverlayRender from './OverlayRender.astro';

/** Hover overlay for Campfire (Figma node 2412:1061): its artwork as one image. */
---

<div class="relative h-[888px] w-[488px] text-cream">
	<div class="art absolute inset-0">
		<OverlayRender name="campfire" alt="The Campfire landing page, with a goldfish swimming out of its corner" />
	</div>
	<div class="caption text-base">
		<p>
			an in-person game jam that took place in 200+ cities across the globe ran in partnership
			with Open Sauce. 18,000+ teenagers participated.
		</p>
	</div>
</div>

