---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import titleArrow from '../../assets/figma/icon-title-arrow.svg?url';
import linkArrow from '../../assets/figma/icon-link-arrow.svg?url';
import LinkHint from '../LinkHint.astro';

/**
 * A project on /work (Figma 2476:1062, light 2512:1242): the cover, the title (with an
 * arrow box when it links somewhere), the subtitle and the blurb, and at the foot the
 * project's links. On desktop it is 640px wide and as tall as the sidebar, the links
 * right under the text; phones get a compact version in a list. The cover always shows
 * whole, in its own shape (never cropped or squashed).
 */
interface Props {
	/** The card's anchor, which /work's project picker links to. */
	id?: string;
	heading: string;
	cover: ImageMetadata;
	href?: string;
	/** One line under the title, in italics (Figma 2536:1853). */
	subtitle?: string;
	blurb?: string;
	/** Label key → url, from the YAML's `links`. */
	links?: Record<string, string>;
	/** Up to three photos from the project, scattered down the right edge (desktop). */
	photos?: ImageMetadata[];
	/** Posters from the project, most of the window's height to the right of the card (desktop). */
	posters?: ImageMetadata[];
	/** Load the cover at once (the project on screen when the page opens), not lazily. */
	priority?: boolean;
	class?: string;
}

const { id, heading, cover, href, subtitle, blurb, links = {}, photos = [], posters = [], priority = false, class: className } = Astro.props;
// A blank line starts a paragraph; *stars* italicise.
const paragraphs = (blurb ?? '')
	.split(/\n\s*\n/)
	.filter(Boolean)
	.map((p) => p.split('*').map((text, i) => ({ text, em: i % 2 === 1 })));
// The cover at 1×, 2× and 3× the desktop width, as far as the file goes, and the file's
// own width as the largest.
const coverWidths = [...[640, 1280, 1920].filter((w) => w < cover.width), cover.width];
const Link = href ? 'a' : 'div';
// Links off the site show where they go in a popover by the pointer (Figma 2539:2832).
const external = (url?: string) => !!url && url.startsWith('http');
const linkProps = href ? { href, target: href.startsWith('http') ? '_blank' : undefined, rel: 'noopener' } : {};

// The links in Figma's order and spelling (portfolio: the writeup on portfolio.manitej.com);
// any other key shows as written.
const LABELS: Record<string, string> = { website: 'Website', demo: 'Demo', portfolio: 'Design Writeup', hcb: 'HCB', github: 'Github' };
const order = Object.keys(LABELS);
const linkList = Object.entries(links)
	.sort(([a], [b]) => (order.indexOf(a) + 1 || order.length + 1) - (order.indexOf(b) + 1 || order.length + 1))
	.map(([key, url]) => ({ label: LABELS[key] ?? key, url }));

// Where the photos sit (Figma 2517:1464, 2517:1463, 2517:1465, in that order, each over
// the one before): measured from the window's top-right corner in Figma, running off its
// right edge, with the frame's size (4px border included) and tilt. Only their spacing
// is kept vertically; the stack is centred (below).
const PHOTO_SLOTS = [
	{ right: -12.58, top: 54.73, width: 320.86, height: 240.58, rotate: -5.47 },
	{ right: -94.23, top: 295.3, width: 485, height: 273, rotate: 3.19 },
	{ right: -39, top: 562, width: 374, height: 249, rotate: -5.19 },
];
// A photo keeps its own shape: its frame has the slot's area, right edge and middle, so a
// photo cut to the slot's shape fills it exactly and a portrait one stands up in it.
const photoFrame = (slot: (typeof PHOTO_SLOTS)[number], photo: ImageMetadata) => {
	const ratio = photo.width / photo.height;
	const width = Math.sqrt(slot.width * slot.height * ratio);
	const height = width / ratio;
	return { width, height, top: slot.top + (slot.height - height) / 2 };
};
// The photos as a stack, centred in the window so it has as much room above as below,
// measured by their tilted outlines.
const frames = photos.slice(0, PHOTO_SLOTS.length).map((photo, i) => {
	const slot = PHOTO_SLOTS[i];
	const frame = photoFrame(slot, photo);
	const turn = (Math.abs(slot.rotate) * Math.PI) / 180;
	const reach = (frame.width * Math.sin(turn) + frame.height * Math.cos(turn)) / 2;
	const middle = frame.top + frame.height / 2;
	return { photo, slot, ...frame, extent: [middle - reach, middle + reach] };
});
const stackTop = Math.min(...frames.map((f) => f.extent[0]));
const stackHeight = Math.max(...frames.map((f) => f.extent[1])) - stackTop;
// Figma's px, as laid out in a 1440 × 900 window; bigger windows scale the stack up with
// whichever of their width and height is the tighter fit (never down, below that).
const PHOTO_UNIT = 'max(1px, min(100vw / 1440, 100vh / 900))';
const unit = (px: number) => `calc(${px} * var(--u))`;

// The posters stand most of the window's height (POSTER_SCALE of it, less 36px top and
// bottom: the sidebar's 24px plus room for their tilt), centred top to bottom. Several
// fan out to the right, each overlapping the one before (which sits on top) by
// 1 - POSTER_STEP of its width, tilting alternately. The group is centred in the space
// right of the card, whose right edge is at 980px on desktop; where that space is too
// narrow it keeps POSTER_GAP from the card and runs off the window's right edge
// instead, as the photos do. The first one's tilt swings a left corner towards the card
// (by `posterTilt`), so the gap is measured from there. All share the first one's shape.
// A fan stands just as tall but bleeds off the window's right edge instead, its last
// poster POSTER_BLEED of its width past it (unless that would bring the fan nearer the
// card than POSTER_GAP). Posters are framed like the photos, in a black border.
const POSTER_TILTS = [1.5, -2.5, 2];
const POSTER_SCALE = 0.88;
const FAN_SCALE = 0.76; // a fan's posters stand a little shorter
const POSTER_GAP = 72;
const POSTER_STEP = 0.8;
const POSTER_BLEED = 0.3;
const posterRatio = posters[0] ? posters[0].width / posters[0].height : 1;
const groupSpan = 1 + POSTER_STEP * (posters.length - 1);
const posterHeight = `(100vh - 72px) * ${posters.length > 1 ? FAN_SCALE : POSTER_SCALE}`;
const posterWidth = `${posterHeight} * ${posterRatio.toFixed(4)}`;
const posterTilt = `${posterHeight} * ${(Math.sin((Math.abs(POSTER_TILTS[0]) * Math.PI) / 180) / 2).toFixed(4)}`;
const groupWidth = `${posterWidth} * ${groupSpan.toFixed(4)}`;
const posterPlace =
	posters.length > 1
		? `calc(100vw - ${groupWidth} + ${posterWidth} * ${POSTER_BLEED})`
		: `calc(980px + (100vw - 980px - ${groupWidth}) / 2)`;
const posterLeft = `max(calc(980px + ${POSTER_GAP}px + ${posterTilt}), ${posterPlace})`;
---

<li id={id} class:list={['card flex w-full shrink-0 snap-start snap-always flex-col items-start gap-6 overflow-y-auto px-6 [scrollbar-width:none] md:overflow-visible md:min-h-[max(640px,calc(100vh-48px))] md:px-0 md:pb-7', className]}>
	<div class="flex min-h-0 w-full flex-col items-start gap-[9.2px] md:gap-4">
		<!-- The cover repeats the title's link, so it stays out of the tab order. On phones it
		     gives up height (whole, never cropped) when the project needs more of the screen. -->
		<Link {...linkProps} tabindex={href ? -1 : undefined} aria-hidden={href ? 'true' : undefined} class:list={['cover-link block min-h-24 w-full md:min-h-0', { 'has-hint': external(href) }]}>
			<!-- Covers are Figma's renders of the cover frames (the 4K set, section 2530:774, is
			     1920×1240: 3× the desktop width), offered at 1×, 2× and 3× so sharp screens
			     get a sharp one. -->
			<Image
				src={cover}
				alt=""
				widths={coverWidths}
				sizes="(min-width: 980px) 640px, calc(100vw - 48px)"
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : undefined}
				class="block h-full w-auto max-w-full object-contain object-left-top md:h-auto md:w-full"
			/>
			{external(href) && <LinkHint href={href!} plain />}
		</Link>
		<div class="flex w-full shrink-0 flex-col items-start gap-[4.6px] md:gap-2">
			<h2 class="text-[27.21px] font-bold text-white md:text-[29.79px]">
				<!-- On hover (the title's or the cover's) the title and its arrow box take the link
				     hover colour together; a title that links nowhere stays put. -->
				<Link
					{...linkProps}
					class:list={[
						'group flex items-center gap-[5.48px] md:gap-[6px]',
						{
							'transition-colors hover:text-link-hover [.card:has(.cover-link:hover)_&]:text-link-hover': href,
							'has-hint': external(href),
						},
					]}
				>
					{heading}
					{
						href && (
							<span class="mt-[4.57px] mr-[3.65px] flex size-[18.26px] shrink-0 md:mt-[5px] md:mr-1 md:size-5 bg-white transition-colors group-hover:bg-link-hover [.card:has(.cover-link:hover)_&]:bg-link-hover" aria-hidden="true">
								<span class="icon mt-[3.22px] ml-[3.04px] size-[12.17px] text-black md:mt-[3.53px] md:ml-[3.33px] md:size-[13.333px]" style={`--icon: url("${titleArrow}")`} />
							</span>
						)
					}
					{external(href) && <LinkHint href={href!} plain />}
				</Link>
			</h2>
			{subtitle && <p class="text-lg text-white italic md:text-xl">{subtitle}</p>}
			{
				paragraphs.length > 0 && (
					<div class="text-lg text-cream md:text-xl [&>p+p]:mt-[1lh]">
						{paragraphs.map((runs) => (
							<p>{runs.map((r) => (r.em ? <em>{r.text}</em> : r.text))}</p>
						))}
					</div>
				)
			}
		</div>
	</div>

	<!-- On desktop the links shrink with the window's height (24px from about 920px tall,
	     down to 16px), their arrows and spacing with them. -->
	{
		linkList.length > 0 && (
			<ul class="mt-auto flex shrink-0 flex-col items-start gap-[0.33em] text-[18.48px] md:mt-0 md:text-[clamp(16px,2.6vh,24px)]">
				{linkList.map((l) => (
					<li>
						<a
							href={l.url}
							target="_blank"
							rel="noopener"
							class:list={['flex items-center gap-[0.25em] whitespace-nowrap text-link transition-colors hover:text-link-hover', { 'has-hint': external(l.url) }]}
						>
							{l.label}
							<span class="icon h-[0.83em] w-[0.46em] shrink-0" style={`--icon: url("${linkArrow}")`} aria-hidden="true" />
							{external(l.url) && <LinkHint href={l.url} plain />}
						</a>
					</li>
				))}
			</ul>
		)
	}

	{
		photos.length > 0 && (
			<div class="hidden min-[1402px]:block" aria-hidden="true">
				{frames.map(({ photo, slot, width, height, top }, i) => {
					return (
						<Image
							src={photo}
							alt=""
							widths={[1, 2, 3].map((k) => Math.round(width * k)).filter((w) => w < photo.width).concat(photo.width)}
							sizes={`max(${width}px, min(${(width / 14.4).toFixed(3)}vw, ${(width / 9).toFixed(3)}vh))`}
							loading="eager"
							class="photo fixed border-black object-cover"
							style={`--u: ${PHOTO_UNIT}; right: ${unit(slot.right)}; top: calc(50vh + ${unit(top - stackTop - stackHeight / 2)}); width: ${unit(width)}; height: ${unit(height)}; border-width: ${unit(4)}; rotate: ${slot.rotate}deg; --n: ${i}`}
						/>
					);
				})}
			</div>
		)
	}

	{
		posters.length > 0 && (
			<div class="hidden min-[1402px]:block" aria-hidden="true">
				{posters.map((poster, i) => (
					<Image
						src={poster}
						alt=""
						widths={[400, 600, 800, 1100, 1400].filter((w) => w < poster.width).concat(poster.width)}
						sizes={`calc(${posterWidth})`}
						loading="eager"
						class="poster photo fixed border-black object-cover"
						style={`top: calc((100vh - ${posterHeight}) / 2); height: calc(${posterHeight}); width: calc(${posterWidth}); --left: calc(${posterLeft} + ${posterWidth} * ${POSTER_STEP * i}); left: var(--left); rotate: ${POSTER_TILTS[i % POSTER_TILTS.length]}deg; z-index: ${posters.length - i}; --n: ${i}; --u: ${PHOTO_UNIT}; border-width: ${unit(4)}`}
					/>
				))}
			</div>
		)
	}
</li>
